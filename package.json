{
  "name": "graphql-object",
  "version": "1.0.3",
  "description": "Use GraphQL syntax to query into an object in-memory.",
  "repository": "AndersDJohnson/graphql-object",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "rollup src/index.js --file dist/index.js --format cjs",
    "build:esm": "rollup src/index.js --file dist/index.mjs --format esm",
    "test": "jest"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "^7.7.6",
    "babel-plugin-graphql-tag": "^2.5.0",
    "graphql": "^14.5.8",
    "graphql-tag": "2.10.1",
    "jest": "^30.5.2",
    "rollup": "^2.80.0"
  },
  "keywords": [
    "graphql",
    "graphql-client",
    "graphql-tag"
  ],
  "license": "MIT"
}